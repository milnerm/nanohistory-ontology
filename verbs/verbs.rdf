     xmlns:rdfstar="http://www.w3.org/ns/rdf-star#"
     xmlns:nanohistory="http://purl.org/nanohistory/ns/#">
    <owl:Ontology rdf:about="http://purl.org/nanohistory/ns/">
        <dc:creator>Matthew Milner</dc:creator>
        <dc:date>2024-07-24</dc:date>
        <dc:description rdf:resource="http://ns.nanohistory.org/versions/2.0.svg"/>
        <dc:description xml:lang="en">Nanohistory.Org employs a distinct approach to event modeling, and the documentation of historical interactions as statements or assertions drawn from a range of documentary evidence and cultural heritage artifacts. Its primary purpose is to provide scholars working in archives and other repositories means of abstracting content history-as-data.</dc:description>
        <dc:language rdf:datatype="http://www.w3.org/2001/XMLSchema#language">en</dc:language>
        <dc:rights xml:lang="en">This ontology is distributed under an MIT License - https://choosealicense.com/licenses/mit/</dc:rights>
        <dc:source>https://www.nanohistory.org</dc:source>
        <dc:title>Verb Child-Ontology for the Nanohistory.Org Data Model</dc:title>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2024-07-24T12:35:48</dcterms:created>
        <vann:changes>First version; initial draft of child ontology consisting of verb sub-properties for main data model.</vann:changes>
        <vann:preferredNamespacePrefix>nanohistoryverbs</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri rdf:resource="http://purl.org/nanohistory/verbs/#"/>
        <rdfs:comment>This ontology provides a list of properties for verbs for the prototype historical research platform Nanohistory.Org</rdfs:comment>
        <owl:versionInfo rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.0</owl:versionInfo>
    </owl:Ontology>
    


